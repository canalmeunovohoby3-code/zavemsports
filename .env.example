# URL pública da loja (usada em metadados e links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Caminho do banco SQLite (padrão: data/zeven.db)
DATABASE_PATH=./data/zeven.db

# Pasta de imagens enviadas pelo painel (padrão: data/uploads)
UPLOAD_DIR=./data/uploads

# Modo demonstração pública, sem SQLite nem uploads locais.
# Na Vercel ele é ativado automaticamente (VERCEL=1).
# Use STORE_DEMO_MODE=true apenas para forçar o modo demo fora da Vercel.
# STORE_DEMO_MODE=true
# Desativação explícita, inclusive na Vercel. Use SOMENTE fora da demonstração.
# STORE_DEMO_MODE=false
# STORE_DEMO_DISABLE=true

# Gateway de pagamento — integração preparada, desativada por padrão.
# Nenhuma cobrança é processada enquanto PAYMENT_PROVIDER=none.
PAYMENT_PROVIDER=none
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# STRIPE_SECRET_KEY=

# Webhook público para confirmação de pagamento (quando integrado)
# PAYMENT_WEBHOOK_SECRET=
